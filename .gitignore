
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# External cloned repos for ecosystem audit / reference reading.
# Keep the parent dir for the empirical-probe scripts (external/probes/),
# but skip the upstream clones — they are reproducible via shallow clone.
external/Arblib.jl/
external/Gremlins.jl/
external/Polynomials.jl/
external/TaylorIntegration.jl/
external/TaylorSeries.jl/
external/chebfun/
external/DMSUITE/
external/heun-refs/motygin-Heun/
external/heun-refs/motygin-confluent-Heun/
external/heun-refs/birkandan-integralseries/
external/heun-refs/birkandan-symODE2/
external/heun-refs/bamber-HeunC-cpp/

# Marker page-image extractions — keep the .md files, skip the bulky .jpeg.
references/markdown/**/*.jpeg

# Generated example plots — regenerable via `julia --project=examples examples/<name>.jl`.
examples/*.png
examples/*.svg
examples/*.pdf
# Exception: the README hero image is a committed doc asset.
!examples/tritronquee_heatmap.png

# Documenter build output + per-environment manifest — regenerable via
# `julia --project=docs docs/make.jl`.
docs/build/
docs/Manifest.toml

# Figure-reproduction project — per-environment manifest is regenerable
# via `julia --project=figures -e 'using Pkg; Pkg.instantiate()'`.
# The output PNGs ARE committed: they are the figure deliverables.
figures/Manifest.toml

# Perf-gate tool env (bead padetaylor-krgy.11) — the Manifest carries an
# absolute `dev` path to the package and is regenerable via
# `julia --project=benchmark -e 'import Pkg; Pkg.develop(path=".."); Pkg.instantiate()'`
# (run_perf_gate.jl also self-heals).  Project.toml + baseline.toml ARE committed.
benchmark/Manifest.toml

# Headline-figure kernel cache — the persistent `res` NamedTuple for
# `figures/kkg_pi2_tritronquee_surface.jl`.  Skipping a render-only
# re-run costs ~3.5 h of CPU; the JLD2 blob saves that.  Regenerable
# via `julia --project=figures figures/kkg_pi2_tritronquee_surface.jl`
# (with `KKG_FORCE_RECOMPUTE=1` to override staleness logic).  The
# output PNGs are committed; the binary cache is not.
figures/output/kkg_pi2_kernel_cache.jld2
figures/output/kkg_pi2_zoom_cache.jld2

# Local scheduling lockfiles.
.claude/scheduled_tasks.lock
external/probes/heun-oracle/capture.log
external/probes/heun-oracle/capture.stderr

# Supposition.jl property-test example database (test/property_test.jl,
# bead padetaylor-krgy.1).  Supposition records each found counterexample
# here for deterministic replay on the next run.  The gate's reproducibility
# comes from its fixed `rng=Xoshiro(0x5eed)` seed, NOT from this directory, so
# the DB is a regenerable runtime artifact — never committed.
test/SuppositionDB/

# Julia coverage artifacts (Coverage.jl / --code-coverage)
*.cov
